# Normalise to LF in the repository, check out native on Windows.
* text=auto

# PowerShell tolerates both; pinning CRLF on checkout keeps ISE and older
# editors from showing everything on one line.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

*.md   text
*.csv  text
*.json text

*.xlsx binary
*.pfx  binary
*.cer  binary
